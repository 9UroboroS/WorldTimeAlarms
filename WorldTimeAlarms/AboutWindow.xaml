<Window x:Class="WorldTimeAlarms.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{DynamicResource Str_About}"
        Icon="/app_logo.ico"
        Width="460"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard"      Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput"     Color="#22263A"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#4F8EF7"/>
        <SolidColorBrush x:Key="AccentGlow"  Color="#2D5DC8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2E3150"/>

        <!-- Section header label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- Feature card container -->
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card header toggle button (clickable to expand) -->
        <Style x:Key="CardToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6AA3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom scrollbar for the content area -->
        <Style x:Key="AboutScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#3A3E5C"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Drop shadow + rounded card -->
    <Border CornerRadius="20"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="6" Opacity="0.65"/>
        </Border.Effect>

        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{StaticResource AccentGlow}"
                            Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="18" Height="18"
                                                   Foreground="{StaticResource AccentBlue}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="World Time Alarms"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtVersion"
                                   Text="{DynamicResource Str_AppVersion}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="1"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnClose_Click"
                        ToolTip="{DynamicResource Str_Close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E3150"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="{StaticResource TextMuted}"/>
                </Button>
            </Grid>

            <!-- Scrollable content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,-14,0" Padding="0,0,14,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AboutScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>

                    <TextBlock Text="{DynamicResource Str_AboutDescription}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                               Margin="0,0,0,18"/>

                    <!-- ═══ SECCIÓN: CARACTERÍSTICAS ═══ -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str_Features}" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Text="  ·  toca una tarjeta para ver más" Foreground="{StaticResource TextMuted}"
                                   FontSize="10" FontStyle="Italic" Opacity="0.8"/>
                    </StackPanel>

                    <!-- Card 1 -->
                    <Border Style="{StaticResource FeatureCard}">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle1" Style="{StaticResource CardToggle}">
                                <ToggleButton.Triggers>
                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details1" Storyboard.TargetProperty="MaxHeight" To="140" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron1" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details1" Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron1" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ToggleButton.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="EarthBox" Width="18" Height="18"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_FeatureClocksTitle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <iconPacks:PackIconMaterial x:Name="Chevron1" Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </iconPacks:PackIconMaterial.RenderTransform>
                                        <iconPacks:PackIconMaterial.RenderTransformOrigin>0.5,0.5</iconPacks:PackIconMaterial.RenderTransformOrigin>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="Details1" MaxHeight="0" ClipToBounds="True">
                                <TextBlock Text="{DynamicResource Str_FeatureClocksDesc}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Margin="32,0,14,12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2 -->
                    <Border Style="{StaticResource FeatureCard}">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle2" Style="{StaticResource CardToggle}">
                                <ToggleButton.Triggers>
                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details2" Storyboard.TargetProperty="MaxHeight" To="160" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron2" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details2" Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron2" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ToggleButton.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="AlarmMultiple" Width="18" Height="18"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_FeatureAlarmsTitle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <iconPacks:PackIconMaterial x:Name="Chevron2" Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </iconPacks:PackIconMaterial.RenderTransform>
                                        <iconPacks:PackIconMaterial.RenderTransformOrigin>0.5,0.5</iconPacks:PackIconMaterial.RenderTransformOrigin>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="Details2" MaxHeight="0" ClipToBounds="True">
                                <TextBlock Text="{DynamicResource Str_FeatureAlarmsDesc}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Margin="32,0,14,12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 3 -->
                    <Border Style="{StaticResource FeatureCard}">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle3" Style="{StaticResource CardToggle}">
                                <ToggleButton.Triggers>
                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details3" Storyboard.TargetProperty="MaxHeight" To="160" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron3" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details3" Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron3" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ToggleButton.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="CheckboxMarkedCircleOutline" Width="18" Height="18"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_FeatureActionsTitle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <iconPacks:PackIconMaterial x:Name="Chevron3" Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </iconPacks:PackIconMaterial.RenderTransform>
                                        <iconPacks:PackIconMaterial.RenderTransformOrigin>0.5,0.5</iconPacks:PackIconMaterial.RenderTransformOrigin>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="Details3" MaxHeight="0" ClipToBounds="True">
                                <TextBlock Text="{DynamicResource Str_FeatureActionsDesc}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Margin="32,0,14,12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 4 -->
                    <Border Style="{StaticResource FeatureCard}">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle4" Style="{StaticResource CardToggle}">
                                <ToggleButton.Triggers>
                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details4" Storyboard.TargetProperty="MaxHeight" To="160" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron4" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details4" Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron4" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ToggleButton.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="History" Width="18" Height="18"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_FeatureHistoryTitle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <iconPacks:PackIconMaterial x:Name="Chevron4" Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </iconPacks:PackIconMaterial.RenderTransform>
                                        <iconPacks:PackIconMaterial.RenderTransformOrigin>0.5,0.5</iconPacks:PackIconMaterial.RenderTransformOrigin>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="Details4" MaxHeight="0" ClipToBounds="True">
                                <TextBlock Text="{DynamicResource Str_FeatureHistoryDesc}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Margin="32,0,14,12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 5 -->
                    <Border Style="{StaticResource FeatureCard}">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle5" Style="{StaticResource CardToggle}">
                                <ToggleButton.Triggers>
                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details5" Storyboard.TargetProperty="MaxHeight" To="160" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron5" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details5" Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron5" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ToggleButton.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="BellRing" Width="18" Height="18"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_FeatureNotifCenterTitle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <iconPacks:PackIconMaterial x:Name="Chevron5" Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </iconPacks:PackIconMaterial.RenderTransform>
                                        <iconPacks:PackIconMaterial.RenderTransformOrigin>0.5,0.5</iconPacks:PackIconMaterial.RenderTransformOrigin>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="Details5" MaxHeight="0" ClipToBounds="True">
                                <TextBlock Text="{DynamicResource Str_FeatureNotifCenterDesc}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Margin="32,0,14,12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 6 -->
                    <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle6" Style="{StaticResource CardToggle}">
                                <ToggleButton.Triggers>
                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details6" Storyboard.TargetProperty="MaxHeight" To="160" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron6" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Details6" Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="Chevron6" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ToggleButton.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="CloudSyncOutline" Width="18" Height="18"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_FeatureTzdbTitle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <iconPacks:PackIconMaterial x:Name="Chevron6" Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </iconPacks:PackIconMaterial.RenderTransform>
                                        <iconPacks:PackIconMaterial.RenderTransformOrigin>0.5,0.5</iconPacks:PackIconMaterial.RenderTransformOrigin>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="Details6" MaxHeight="0" ClipToBounds="True">
                                <TextBlock Text="{DynamicResource Str_FeatureTzdbDesc}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Margin="32,0,14,12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,16,0,16"/>

                    <!-- ═══ SECCIÓN: CÓMO FUNCIONA ═══ -->
                    <TextBlock Text="{DynamicResource Str_HowItWorks}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,18">
                        <Run Text="{DynamicResource Str_HowItWorksStep1}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Str_HowItWorksStep2}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Str_HowItWorksStep3}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Str_HowItWorksStep4}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Str_HowItWorksStep5}"/>
                    </TextBlock>

                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,16"/>

                    <!-- ═══ SECCIÓN: TECNOLOGÍA ═══ -->
                    <TextBlock Text="{DynamicResource Str_Technology}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{DynamicResource Str_TechnologyDesc}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                               Margin="0,0,0,4"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Cerrar -->
            <Button Grid.Row="2"
                    Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Stretch"
                    Margin="0,20,0,0"
                    Click="BtnClose_Click">
                <TextBlock Text="{DynamicResource Str_Close}" VerticalAlignment="Center"/>
            </Button>

        </Grid>
    </Border>
</Window>
