<Window x:Class="WorldTimeAlarms.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{DynamicResource Str_SettingsTitle}"
        Icon="/app_logo.ico"
        Width="480"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard"      Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput"     Color="#22263A"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#4F8EF7"/>
        <SolidColorBrush x:Key="AccentGlow"  Color="#2D5DC8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2E3150"/>
        <SolidColorBrush x:Key="Danger"      Color="#7F1D1D"/>
        <SolidColorBrush x:Key="DangerFg"    Color="#FCA5A5"/>

        <!-- Section header label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- Row separator -->
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height"          Value="1"/>
            <Setter Property="Background"      Value="{StaticResource BorderColor}"/>
            <Setter Property="Margin"          Value="0,4"/>
        </Style>

        <!-- ComboBox dark style -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton HorizontalAlignment="Right" Width="32"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path Data="M 0 0 L 8 8 L 16 0" Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="2" Margin="8,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{StaticResource BgCard}" CornerRadius="8"
                                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        MaxHeight="220" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{StaticResource BgCard}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Padding"    Value="12,7"/>
                    <Setter Property="FontSize"   Value="13"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2F47"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentGlow}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Button primary -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6AA3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle row style helper -->
        <Style x:Key="ToggleRow" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                    <Setter Property="Background"  Value="#262A40"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern toggle switch (replaces default CheckBox look) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track"
                                    Width="44" Height="24"
                                    CornerRadius="12"
                                    Background="{StaticResource BorderColor}"
                                    BorderBrush="#3A3E5C"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="#C7CBE8"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#4F8EF7" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Thumb"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#FFFFFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#2E3150" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Thumb"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#C7CBE8" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (cancel) button -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom scrollbar for the content area -->
        <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#3A3E5C"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Drop shadow + rounded card -->
    <Border CornerRadius="20"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="6" Opacity="0.65"/>
        </Border.Effect>

        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{StaticResource AccentGlow}"
                            Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18"
                                                   Foreground="{StaticResource AccentBlue}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_SettingsTitle}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Str_SettingsSubtitle}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- About button -->
                <Button Grid.Column="1"
                        Width="28" Height="28" Padding="0"
                        Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnAbout_Click"
                        ToolTip="{DynamicResource Str_About}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E3150"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <iconPacks:PackIconMaterial Kind="InformationOutline" Width="15" Height="15" Foreground="{StaticResource TextMuted}"/>
                </Button>

                <!-- Close button -->
                <Button Grid.Column="2"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnClose_Click"
                        ToolTip="{DynamicResource Str_Close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E3150"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="{StaticResource TextMuted}"/>
                </Button>
            </Grid>

            <!-- Scrollable settings content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,-14,0" Padding="0,0,14,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>

            <!-- ═══ SECCIÓN: RELOJ ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconMaterial Kind="ClockOutline" Width="12" Height="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource Str_SectionClock}" Style="{StaticResource SectionLabel}" Margin="0"/>
            </StackPanel>

            <Border Style="{StaticResource ToggleRow}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_LocalTimeZoneLabel}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CboTimeZone"
                              Style="{StaticResource DarkCombo}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,4,0,16"/>

            <!-- ═══ SECCIÓN: SISTEMA ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconMaterial Kind="Laptop" Width="12" Height="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource Str_SectionSystem}" Style="{StaticResource SectionLabel}" Margin="0"/>
            </StackPanel>

            <!-- Iniciar con Windows -->
            <Border Style="{StaticResource ToggleRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_StartWithWindows}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_StartWithWindowsHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkStartup" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"
                              Checked="ChkStartup_Changed"
                              Unchecked="ChkStartup_Changed"/>
                </Grid>
            </Border>

            <!-- Minimizar al cerrar -->
            <Border Style="{StaticResource ToggleRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_MinimizeOnClose}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_MinimizeOnCloseHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkMinimizeOnClose" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Idioma -->
            <Border Style="{StaticResource ToggleRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Language}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_LanguageHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox x:Name="CboLanguage" Grid.Column="1"
                              Style="{StaticResource DarkCombo}"
                              Width="140"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Actualizaciones -->
            <Border Style="{StaticResource ToggleRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str_CheckUpdates}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_CheckUpdatesHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource BtnSecondary}"
                            Width="170"
                            Content="{DynamicResource Str_CheckNow}"
                            Click="BtnCheckUpdates_Click"/>
                </Grid>
            </Border>

            <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,4,0,16"/>

            <!-- ═══ SECCIÓN: ALARMAS ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconMaterial Kind="BellRing" Width="12" Height="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource Str_SectionAlarms}" Style="{StaticResource SectionLabel}" Margin="0"/>
            </StackPanel>

            <!-- Formato horario -->
            <Border Style="{StaticResource ToggleRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Use24HourFormat}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_Use24HourFormatHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkUse24HourFormat" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Sonido al disparar -->
            <Border Style="{StaticResource ToggleRow}" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_SoundOnAlarm}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_SoundOnAlarmHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkSound" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ToggleRow}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str_NotificationLimit}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str_NotificationLimitHint}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="TxtNotificationLimit"
                             Grid.Column="1"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Background="{StaticResource BgInput}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderColor}"
                             BorderThickness="1"/>
                </Grid>
            </Border>

            <!-- Error/info message -->
            <TextBlock x:Name="TxtMsg"
                       Foreground="#F87171"
                       FontSize="11"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Guardar / Cancelar -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource BtnSecondary}"
                        Content="{DynamicResource Str_Cancel}"
                        Click="BtnClose_Click"/>
                <Button x:Name="BtnSave" Grid.Column="2"
                        Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="15" Height="15"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_SaveChanges}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
