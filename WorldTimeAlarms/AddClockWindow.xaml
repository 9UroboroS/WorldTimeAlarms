<Window x:Class="WorldTimeAlarms.AddClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:WorldTimeAlarms"
        Title="{DynamicResource Str_AddClockTitleWindow}"
        Icon="/app_logo.ico"
        Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard"      Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput"     Color="#22263A"/>
        <SolidColorBrush x:Key="BgSeparator" Color="#2E3150"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#4F8EF7"/>
        <SolidColorBrush x:Key="AccentGlow"  Color="#2D5DC8"/>
        <SolidColorBrush x:Key="AccentGold"  Color="#FBBF24"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2E3150"/>

        <!-- TextBox oscuro sin template propio -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,8"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="CaretBrush"               Value="{StaticResource AccentBlue}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ListBox contenedor de zonas -->
        <Style x:Key="ZoneListBox" TargetType="ListBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- CanContentScroll=True fijado localmente supera el estilo global False -->
                            <ScrollViewer CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Visible"
                                          Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item de zona horaria -->
        <Style x:Key="ZoneItem" TargetType="ListBoxItem">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding"       Value="0"/>
            <Setter Property="Margin"        Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2F47"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6AA3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- título -->
                <RowDefinition Height="Auto"/>  <!-- nombre label -->
                <RowDefinition Height="Auto"/>  <!-- nombre input -->
                <RowDefinition Height="Auto"/>  <!-- zona label -->
                <RowDefinition Height="*"/>     <!-- TzPickerControl -->
                <RowDefinition Height="Auto"/>  <!-- error -->
                <RowDefinition Height="Auto"/>  <!-- guardar -->
            </Grid.RowDefinitions>

            <!-- ── Título ── -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Earth" Width="16" Height="16"
                                               Foreground="{StaticResource AccentBlue}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="{DynamicResource Str_AddClockTitle}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Width="26" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E3150"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12"
                                               Foreground="{StaticResource TextMuted}"/>
                </Button>
            </Grid>

            <!-- ── Nombre ── -->
            <TextBlock Grid.Row="1" Text="{DynamicResource Str_NameOrCity}"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12" Margin="0,0,0,6"/>
            <TextBox Grid.Row="2" x:Name="TxtLabel"
                     Style="{StaticResource DarkTextBox}"
                     MaxLength="40" Margin="0,0,0,16">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- ── Zona horaria ── -->
            <TextBlock Grid.Row="3" Text="{DynamicResource Str_TimeZone}"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12" Margin="0,0,0,6"/>

            <!-- Picker con buscador y favoritos -->
            <local:TzPickerControl Grid.Row="4" x:Name="TzPicker"
                                   Margin="0,0,0,12"/>

            <!-- Error -->
            <TextBlock Grid.Row="5" x:Name="TxtError"
                       Foreground="#F87171"
                       FontSize="11"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Guardar -->
            <Button Grid.Row="6"
                    Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Stretch"
                    Padding="0"
                    Click="BtnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>
    </Border>
</Window>
