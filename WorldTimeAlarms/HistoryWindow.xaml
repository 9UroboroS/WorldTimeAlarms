<Window x:Class="WorldTimeAlarms.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{DynamicResource Str_HistoryTitleWindow}"
        Width="860" Height="640"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="#13151F"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Icon="/app_logo.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Paleta -->
        <SolidColorBrush x:Key="BgBase"      Color="#13151F"/>
        <SolidColorBrush x:Key="BgSurface"   Color="#1A1D2B"/>
        <SolidColorBrush x:Key="BgCard"      Color="#1F2235"/>
        <SolidColorBrush x:Key="BgInput"     Color="#252840"/>
        <SolidColorBrush x:Key="BgHover"     Color="#2C3050"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#4F8EF7"/>
        <SolidColorBrush x:Key="AccentBlueL" Color="#7AADFF"/>
        <SolidColorBrush x:Key="AccentGold"  Color="#FBBF24"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextSecond"  Color="#A5B0CC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#5B6480"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2B3050"/>

        <SolidColorBrush x:Key="BorderFocus" Color="#4F8EF7"/>

        <!-- TextBox oscuro -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"              Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"              Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"              Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="Height"                  Value="34"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"              Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"              Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Height"                  Value="34"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background"  Value="{StaticResource BgInput}"/>
                        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding"     Value="10,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="10,0,30,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                            <!-- Flecha -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Right"
                                          Width="30"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="{StaticResource BgInput}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker oscuro -->
        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background"              Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"              Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Height"                  Value="34"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="{StaticResource BgCard}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="FontSize"   Value="13"/>
                        <Setter Property="CalendarDayButtonStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarDayButton">
                                    <Setter Property="FontSize"     Value="13"/>
                                    <Setter Property="Foreground"   Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="Background"   Value="Transparent"/>
                                    <Setter Property="MinWidth"     Value="32"/>
                                    <Setter Property="MinHeight"    Value="28"/>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="CalendarButtonStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarButton">
                                    <Setter Property="FontSize"   Value="13"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid Margin="8,0,4,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   BorderThickness="0"
                                                   Padding="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{TemplateBinding FontSize}"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="28" Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <iconPacks:PackIconMaterial Kind="CalendarMonthOutline"
                                                               Width="16" Height="16"
                                                               Foreground="{StaticResource TextMuted}"/>
                                </Button>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlueL}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D5DC8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón peligro -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
        </Style>

        <!-- Botón fantasma -->
        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de historial -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- Separador de secciones -->
        <Style x:Key="SectionSep" TargetType="Border">
            <Setter Property="Background"  Value="{StaticResource BorderColor}"/>
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Margin"      Value="0,12,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- cabecera -->
            <RowDefinition Height="Auto"/>
            <!-- barra búsqueda/filtros -->
            <RowDefinition Height="Auto"/>
            <!-- barra fechas/exportar -->
            <RowDefinition Height="*"/>
            <!-- lista -->
            <RowDefinition Height="Auto"/>
            <!-- paginación -->
        </Grid.RowDefinitions>

        <!-- ══ CABECERA ══ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="24,14,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A6E" CornerRadius="8" Padding="8,6" Margin="0,0,14,0">
                        <iconPacks:PackIconMaterial Kind="History"
                                                   Width="18" Height="18"
                                                   Foreground="{StaticResource AccentBlue}"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_HistoryTitle}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSubtitleLabel"
                                   Text="{DynamicResource Str_Loading}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource BtnGhost}"
                        Width="36" Height="36" Padding="0"
                        ToolTip="{DynamicResource Str_CloseHistory}"
                        Click="BtnClose_Click">
                    <iconPacks:PackIconMaterial Kind="Close"
                                               Width="14" Height="14"
                                               Foreground="{StaticResource TextMuted}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ BARRA BÚSQUEDA / FILTROS ══ -->
        <Border Grid.Row="1"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,10,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Buscador con ícono -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgInput}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,10,0"
                        Height="34">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Magnify"
                                                   Width="14" Height="14"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource AccentBlue}"
                                 BorderThickness="0"
                                 Padding="8,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Border>

                <ComboBox x:Name="CboFilter"
                          Grid.Column="1"
                          Style="{StaticResource DarkCombo}"
                          Margin="0,0,10,0"
                          ToolTip="{DynamicResource Str_FilterByState}">
                    <ComboBoxItem Content="{DynamicResource Str_AllStates}" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Str_Attended_Plural}"/>
                    <ComboBoxItem Content="{DynamicResource Str_NotAttended_Plural}"/>
                </ComboBox>

                <ComboBox x:Name="CboSort"
                          Grid.Column="2"
                          Style="{StaticResource DarkCombo}"
                          Margin="0,0,10,0"
                          ToolTip="{DynamicResource Str_SortBy}">
                    <ComboBoxItem Content="{DynamicResource Str_MostRecent}" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Str_Oldest}"/>
                    <ComboBoxItem Content="{DynamicResource Str_State}"/>
                </ComboBox>

                <Button Grid.Column="3"
                        Style="{StaticResource BtnDanger}"
                        ToolTip="{DynamicResource Str_ClearHistory}"
                        Click="BtnClearHistory_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="DeleteSweep"
                                                   Width="14" Height="14"
                                                   Margin="0,0,6,0"
                                                   Foreground="#FCA5A5"/>
                        <TextBlock Text="{DynamicResource Str_Clear}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ BARRA FECHAS / EXPORTAR ══ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Str_From}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker x:Name="DpkFrom"
                            Grid.Column="1"
                            Style="{StaticResource DarkDatePicker}"
                            Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Str_To}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker x:Name="DpkTo"
                            Grid.Column="3"
                            Style="{StaticResource DarkDatePicker}"
                            Margin="0,0,12,0"/>

                <ComboBox x:Name="CboExportScope"
                          Grid.Column="4"
                          Style="{StaticResource DarkCombo}"
                          Margin="0,0,12,0"
                          ToolTip="{DynamicResource Str_ExportScope}">
                    <ComboBoxItem Content="{DynamicResource Str_CurrentPage}" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Str_Selected}"/>
                    <ComboBoxItem Content="{DynamicResource Str_AllResults}"/>
                </ComboBox>

                <TextBlock x:Name="TxtResultsCount"
                           Grid.Column="5"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,14,0"
                           Text="0 resultados"/>

                <Button Grid.Column="6"
                        Style="{StaticResource BtnGhost}"
                        ToolTip="{DynamicResource Str_ExportJson}"
                        Margin="0,0,6,0"
                        Click="BtnExportJson_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CodeJson"
                                                   Width="14" Height="14"
                                                   Margin="0,0,6,0"
                                                   Foreground="{StaticResource AccentBlue}"/>
                        <TextBlock Text="JSON" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="7"
                        Style="{StaticResource BtnGhost}"
                        ToolTip="{DynamicResource Str_ExportCsv}"
                        Click="BtnExportCsv_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDelimitedOutline"
                                                   Width="14" Height="14"
                                                   Margin="0,0,6,0"
                                                   Foreground="{StaticResource AccentBlue}"/>
                        <TextBlock Text="CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ LISTA ══ -->
        <Grid Grid.Row="3">
            <ListBox x:Name="IcHistory"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="16,12,16,12"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.PanningMode="VerticalFirst"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False"
                                      Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"          Value="0"/>
                        <Setter Property="Margin"           Value="0"/>
                        <Setter Property="Background"       Value="Transparent"/>
                        <Setter Property="BorderThickness"  Value="0"/>
                        <Setter Property="Focusable"        Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCard}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"      Value="{StaticResource BgCard}"/>
                                    <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius"    Value="12"/>
                                    <Setter Property="Padding"         Value="16,14"/>
                                    <Setter Property="Margin"          Value="0,0,0,8"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.25" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                            <Setter Property="Background"  Value="{StaticResource BgHover}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#4F8EF7" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <!-- Fila principal: tiempo + favorito + estado -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeText}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="22" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DateText}"
                                                       Foreground="{StaticResource TextSecond}"
                                                       FontSize="13"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <iconPacks:PackIconMaterial Kind="MapMarkerOutline"
                                                                       Width="12" Height="12"
                                                                       Foreground="{StaticResource AccentBlue}"
                                                                       Margin="0,1,4,0"
                                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ZoneName}"
                                                       Foreground="{StaticResource AccentBlue}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Estado + Favorito arriba a la derecha -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Border Background="{Binding EstadoLabelBackgroundBrush}"
                                                CornerRadius="999"
                                                Padding="10,4"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding EstadoLabel}"
                                                       Foreground="{Binding EstadoLabelBrush}"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <Button Style="{StaticResource BtnGhost}"
                                                Height="28" Width="28" Padding="0"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Right"
                                                ToolTip="{DynamicResource Str_ToggleFavorite}"
                                                Click="BtnToggleFavorite_Click"
                                                Tag="{Binding}">
                                            <iconPacks:PackIconMaterial Kind="{Binding FavoriteIcon}"
                                                                       Width="16" Height="16"
                                                                       Foreground="{Binding FavoriteBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Separador -->
                                <Border Style="{StaticResource SectionSep}"/>

                                <!-- Acciones y checkbox -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              ToolTip="{DynamicResource Str_SelectToExport}"
                                              IsChecked="{Binding IsSelected}"
                                              Click="ChkSelectItem_Click"/>

                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnPrimary}"
                                                Height="30" Padding="10,0" Margin="0,0,8,6"
                                                ToolTip="{DynamicResource Str_ReuseThisAlarm}"
                                                Click="BtnReuseAlarm_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="BellPlus" Width="13" Height="13"
                                                                           Margin="0,0,6,0" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Str_Reuse}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource BtnGhost}"
                                                Height="30" Padding="10,0" Margin="0,0,8,6"
                                                ToolTip="{DynamicResource Str_DuplicateWithEdit}"
                                                Click="BtnDuplicateAlarm_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="13" Height="13"
                                                                           Margin="0,0,6,0" Foreground="{StaticResource TextSecond}"/>
                                                <TextBlock Text="{DynamicResource Str_Duplicate}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource BtnGhost}"
                                                Height="30" Padding="10,0" Margin="0,0,8,6"
                                                Visibility="{Binding LinkVisibility}"
                                                ToolTip="{DynamicResource Str_OpenWebLink}"
                                                Click="BtnOpenLink_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="OpenInNew" Width="13" Height="13"
                                                                           Margin="0,0,6,0" Foreground="{StaticResource AccentBlue}"/>
                                                <TextBlock Text="{DynamicResource Str_Link}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource BtnGhost}"
                                                Height="30" Padding="10,0" Margin="0,0,8,6"
                                                Visibility="{Binding LinkVisibility}"
                                                ToolTip="{DynamicResource Str_CopyLinkTooltip}"
                                                Click="BtnCopyLink_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="13" Height="13"
                                                                           Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{DynamicResource Str_CopyLink}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource BtnDanger}"
                                                Height="30" Padding="10,0" Margin="0,0,0,6"
                                                ToolTip="{DynamicResource Str_DeleteFromHistory}"
                                                Click="BtnDeleteItem_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="13" Height="13"
                                                                           Margin="0,0,6,0" Foreground="#FCA5A5"/>
                                                <TextBlock Text="{DynamicResource Str_Delete}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <!-- Detalles expandibles -->
                                <Expander Margin="0,8,0,0"
                                          Foreground="{StaticResource TextSecond}"
                                          Background="Transparent"
                                          FontSize="12">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource Str_ViewDetails}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"/>
                                    </Expander.Header>

                                    <Border Background="{StaticResource BgInput}"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                                <Run Text="{DynamicResource Str_Finalized}"/>
                                                <Run Text="{Binding FinalizedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                     Foreground="{StaticResource TextSecond}"/>
                                                <Run Text=" UTC"/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Nota}"
                                                       Foreground="{StaticResource TextSecond}"
                                                       FontSize="12" Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding NoteVisibility}"/>

                                            <Border Background="#1B2336"
                                                    BorderBrush="#2B3A5B" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,6"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding LinkVisibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="LinkVariant"
                                                                               Width="12" Height="12"
                                                                               Foreground="{StaticResource AccentBlue}"
                                                                               Margin="0,1,8,0"
                                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding LinkUrl}"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding LinkUrl}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TxtEmpty"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed">
                <Run Text="{DynamicResource Str_NoHistoryEntries}"
                     Foreground="#4F5470"
                     FontSize="14"/>
            </TextBlock>
        </Grid>

        <!-- ══ PAGINACIÓN ══ -->
        <Border Grid.Row="4"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource BtnGhost}"
                        Width="120"
                        Click="BtnPreviousPage_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="14" Height="14"
                                                   Margin="0,0,6,0" Foreground="{StaticResource TextSecond}"/>
                        <TextBlock Text="{DynamicResource Str_Previous}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="TxtPageInfo"
                           Grid.Column="1"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="Página 1 de 1"/>

                <Button Grid.Column="2"
                        Style="{StaticResource BtnGhost}"
                        Width="120"
                        Click="BtnNextPage_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str_Next}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <iconPacks:PackIconMaterial Kind="ChevronRight" Width="14" Height="14"
                                                   Foreground="{StaticResource TextSecond}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
