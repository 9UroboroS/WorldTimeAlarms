    <!-- AboutWindow -->
    <system:String x:Key="Str_AppVersion">Versión {0}</system:String>
    <system:String x:Key="Str_AboutDescription">Una aplicación de escritorio para gestionar relojes mundiales y alarmas con precisión horaria real, pensada para quienes trabajan o se comunican entre distintas zonas horarias.</system:String>
    <system:String x:Key="Str_Features">CARACTERÍSTICAS</system:String>
    <system:String x:Key="Str_FeatureClocksTitle">Relojes mundiales personalizables</system:String>
    <system:String x:Key="Str_FeatureClocksDesc">Agrega, edita y elimina relojes de cualquier zona horaria, con búsqueda por ciudad y favoritos anclados al inicio de la lista.</system:String>
    <system:String x:Key="Str_FeatureAlarmsTitle">Alarmas entre zonas horarias</system:String>
    <system:String x:Key="Str_FeatureAlarmsDesc">Crea alarmas en la zona horaria que elijas, con notas y enlaces opcionales, cuenta regresiva en tiempo real e indicadores de urgencia por color (verde, naranja, rojo).</system:String>
    <system:String x:Key="Str_FeatureActionsTitle">Atender, posponer o descartar</system:String>
    <system:String x:Key="Str_FeatureActionsDesc">Al dispararse una alarma, decide si la atendiste, la pospones por un tiempo adicional o la marcas como no atendida.</system:String>
    <system:String x:Key="Str_FeatureHistoryTitle">Historial completo</system:String>
    <system:String x:Key="Str_FeatureHistoryDesc">Consulta todas las alarmas pasadas con su estado final, filtra, ordena, exporta a JSON/CSV y reutiliza alarmas anteriores para crear nuevas rápidamente.</system:String>
    <system:String x:Key="Str_FeatureNotifCenterTitle">Centro de notificaciones</system:String>
    <system:String x:Key="Str_FeatureNotifCenterDesc">Avisos de alarmas próximas y del estado de la base horaria, con badge de no leídas, filtros por categoría y contador en la barra de tareas.</system:String>
    <system:String x:Key="Str_FeatureTzdbTitle">Precisión horaria actualizada</system:String>
    <system:String x:Key="Str_FeatureTzdbDesc">La base de datos de husos horarios (TZDB) se actualiza automáticamente en segundo plano para reflejar cambios de horario de verano y reglas de cada país.</system:String>
    <system:String x:Key="Str_HowItWorks">CÓMO FUNCIONA</system:String>
    <system:String x:Key="Str_HowItWorksStep1">1. Agrega los relojes de las ciudades que te interesan desde el panel principal.</system:String>
    <system:String x:Key="Str_HowItWorksStep2">2. Crea una alarma eligiendo la zona horaria, hora, notas y enlace opcional.</system:String>
    <system:String x:Key="Str_HowItWorksStep3">3. La app calculará automáticamente la cuenta regresiva y te avisará cuando falte poco.</system:String>
    <system:String x:Key="Str_HowItWorksStep4">4. Al sonar la alarma, decide si la atendiste, la pospones o la ignoras.</system:String>
    <system:String x:Key="Str_HowItWorksStep5">5. Consulta el Historial para ver el resultado de todas tus alarmas anteriores.</system:String>
    <system:String x:Key="Str_Technology">TECNOLOGÍA</system:String>
    <system:String x:Key="Str_TechnologyDesc">Desarrollado en .NET y WPF, con NodaTime para cálculos de zona horaria basados en la base de datos IANA (TZDB).</system:String>

