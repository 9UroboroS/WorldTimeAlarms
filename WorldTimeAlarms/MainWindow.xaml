<Window x:Class="WorldTimeAlarms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldTimeAlarms"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}"
        Icon="/app_logo.ico"
        Height="820" Width="980"
        MinHeight="720" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Background="#0F1117">

    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="MainTaskbarItemInfo"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>

        <!-- Colours -->
        <SolidColorBrush x:Key="BgDeep"      Color="#0F1117"/>
        <SolidColorBrush x:Key="BgCard"      Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput"     Color="#22263A"/>
        <SolidColorBrush x:Key="BgHover"     Color="#2A2F47"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#4F8EF7"/>
        <SolidColorBrush x:Key="AccentGlow"  Color="#2D5DC8"/>
        <SolidColorBrush x:Key="AccentLink"  Color="#60A5FA"/>
        <SolidColorBrush x:Key="AccentLinkHover" Color="#93C5FD"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B7280"/>
        <SolidColorBrush x:Key="Border"      Color="#2E3150"/>
        <SolidColorBrush x:Key="AlarmBadge"  Color="#F59E0B"/>

        <Style x:Key="AlarmLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentLink}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentLinkHover}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondarySmall" TargetType="Button">
            <Setter Property="Background"   Value="#24304A"/>
            <Setter Property="Foreground"   Value="#D7E3FF"/>
            <Setter Property="BorderBrush"  Value="#355189"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Height"       Value="28"/>
            <Setter Property="Padding"      Value="10,0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E4370"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"           Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"           Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"          Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness"      Value="1"/>
            <Setter Property="Padding"              Value="10,6"/>
            <Setter Property="Height"               Value="36"/>
            <Setter Property="FontSize"             Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton HorizontalAlignment="Right" Width="32"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path Data="M 0 0 L 8 8 L 16 0" Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="2" Margin="8,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{StaticResource BgCard}" CornerRadius="8"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        MaxHeight="220" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"  Value="{StaticResource BgCard}"/>
                    <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Padding"     Value="12,7"/>
                    <Setter Property="FontSize"    Value="13"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentGlow}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- TextBox style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker style -->
        <!-- Estilo interno del TextBox del DatePicker -->
        <Style x:Key="DarkDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="Transparent"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="PART_Watermark"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Style="{StaticResource DarkDatePickerTextBox}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Background="Transparent"
                                                   Padding="10,0,0,0"
                                                   VerticalAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="30"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="0,8,8,0"
                                                    x:Name="btnBd">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="btnBd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#2A2F47" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Data="M 2 0 L 2 2 L 0 2 L 0 3 L 10 3 L 10 2 L 8 2 L 8 0 L 7 0 L 7 2 L 3 2 L 3 0 Z M 0 4 L 10 4 L 10 10 L 0 10 Z"
                                          Fill="{StaticResource AccentBlue}"
                                          Width="10" Height="10"
                                          Stretch="Uniform"/>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=border}"
                                       Placement="Bottom"
                                       StaysOpen="False">
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="18,0"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Height"       Value="38"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6AA3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (delete) -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background"      Value="#7F1D1D"/>
            <Setter Property="Foreground"      Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="ToolTip"         Value="Eliminar alarma"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card border -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="20"/>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
            <Setter Property="Text"       Value="LABEL"/>
        </Style>



    </Window.Resources>

    <!-- ROOT LAYOUT -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header bar -->
            <RowDefinition Height="*"/>     <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- world clocks footer -->
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="#13162080" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- app icon glyph -->
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="{StaticResource AccentBlue}" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="ClockOutline" Width="18" Height="18"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Str_AppTitle}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- local timezone selector + tray button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_LocalZoneLabel}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboLocalZone"
                              Style="{StaticResource DarkCombo}"
                              Width="260"
                              Margin="10,0,0,0"
                              SelectionChanged="CboLocalZone_SelectionChanged"/>
                    <Button ToolTip="{DynamicResource Str_Settings}"
                            Style="{StaticResource BtnPrimary}"
                            Width="36" Height="36" Margin="8,0,0,0"
                            Padding="0"
                            Click="BtnSettings_Click">
                        <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16"
                                                   Foreground="White"/>
                    </Button>
                    <Button ToolTip="{DynamicResource Str_History}"
                            Style="{StaticResource BtnPrimary}"
                            Width="36" Height="36" Margin="8,0,0,0"
                            Padding="0"
                            Click="BtnHistory_Click">
                        <iconPacks:PackIconMaterial Kind="History" Width="16" Height="16"
                                                   Foreground="White"/>
                    </Button>

                    <Grid Margin="8,0,0,0">
                        <Button x:Name="BtnNotifications"
                                ToolTip="{DynamicResource Str_NotificationsTooltip}"
                                Style="{StaticResource BtnPrimary}"
                                Width="36" Height="36"
                                Padding="0"
                                Click="BtnNotifications_Click">
                            <iconPacks:PackIconMaterial Kind="BellOutline" Width="16" Height="16"
                                                       Foreground="White"/>
                        </Button>

                        <Border x:Name="NotificationBadge"
                                Width="18" Height="18"
                                CornerRadius="9"
                                Background="#EF4444"
                                BorderBrush="#1A1D27"
                                BorderThickness="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtNotificationBadge"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Popup x:Name="NotificationsPopup"
                               PlacementTarget="{Binding ElementName=BtnNotifications}"
                               Placement="Bottom"
                               VerticalOffset="10"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Width="360"
                                    Background="#171B27"
                                    BorderBrush="#2E3150"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="260"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="BellAlertOutline"
                                                                       Width="16" Height="16"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#F59E0B"/>
                                            <TextBlock Text="{DynamicResource Str_Notifications}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="15"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="{DynamicResource Str_ClearNotifications}"
                                                Style="{StaticResource BtnSecondarySmall}"
                                                Click="BtnClearNotifications_Click"/>

                                        <Button Grid.Column="3"
                                                Content="{DynamicResource Str_MarkAllRead}"
                                                Style="{StaticResource BtnSecondarySmall}"
                                                Click="BtnMarkAllNotificationsRead_Click"/>

                                        <Button Grid.Column="5"
                                                Content="{DynamicResource Str_Empty}"
                                                Style="{StaticResource BtnSecondarySmall}"
                                                Click="BtnEmptyNotifications_Click"/>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource Str_ShowLabel}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CboNotificationScope"
                                                  Grid.Column="1"
                                                  Style="{StaticResource DarkCombo}"
                                                  Height="30"
                                                  SelectionChanged="CboNotificationScope_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Str_Unread}" IsSelected="True"/>
                                            <ComboBoxItem Content="{DynamicResource Str_All}"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="3"
                                                   Text="{DynamicResource Str_FilterLabel}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CboNotificationFilter"
                                                  Grid.Column="4"
                                                  Style="{StaticResource DarkCombo}"
                                                  Height="30"
                                                  SelectionChanged="CboNotificationFilter_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Str_All}" IsSelected="True"/>
                                            <ComboBoxItem Content="{DynamicResource Str_CategoryAlarms}"/>
                                            <ComboBoxItem Content="{DynamicResource Str_CategoryTzdb}"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Grid.Row="4"
                                            Background="#111522"
                                            BorderBrush="#232842"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <ListBox x:Name="LstNotifications"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="8"
                                                                Padding="12"
                                                                Background="#1E2435"
                                                                BorderBrush="#2B3250"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Opacity="{Binding ItemOpacity}">
                                                           <Border.Effect>
                                                               <DropShadowEffect Color="#000000"
                                                                                 BlurRadius="14"
                                                                                 ShadowDepth="2"
                                                                                 Opacity="0.28"
                                                                                 Direction="270"/>
                                                           </Border.Effect>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Width="32" Height="32"
                                                                        CornerRadius="16"
                                                                        Background="{Binding AccentBackgroundBrush}"
                                                                        VerticalAlignment="Top">
                                                                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                                                               Width="15" Height="15"
                                                                                               Foreground="{Binding AccentBrush}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="{StaticResource TextPrimary}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="13"/>
                                                                    <TextBlock Text="{Binding Message}"
                                                                               Foreground="#C7D2FE"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,4,0,6"
                                                                               FontSize="12"/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                                                   Foreground="#93C5FD"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"/>
                                                                        <TextBlock Text=" · "
                                                                                   Foreground="{StaticResource TextMuted}"
                                                                                   FontSize="10"/>
                                                                        <TextBlock Text="{Binding TimeText}"
                                                                                   Foreground="{StaticResource TextMuted}"
                                                                                   FontSize="10"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding FullDateText}"
                                                                               Foreground="{StaticResource TextMuted}"
                                                                               FontSize="10"
                                                                               Margin="0,4,0,0"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2"
                                                                            VerticalAlignment="Top">
                                                                    <Button Width="26" Height="26"
                                                                            Padding="0"
                                                                            Margin="0,0,0,6"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            Tag="{Binding}"
                                                                            Click="BtnMarkNotificationRead_Click">
                                                                        <iconPacks:PackIconMaterial Kind="Check"
                                                                                                   Width="14" Height="14"
                                                                                                   Foreground="#86EFAC"/>
                                                                    </Button>
                                                                    <Button Width="26" Height="26"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            Tag="{Binding}"
                                                                            Click="BtnDismissNotification_Click">
                                                                        <iconPacks:PackIconMaterial Kind="Close"
                                                                                                   Width="14" Height="14"
                                                                                                   Foreground="#9CA3AF"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock x:Name="TxtNoNotifications"
                                                       Text="{DynamicResource Str_NoNotifications}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="6"
                                               Text="{DynamicResource Str_NotificationsHint}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Margin="10,0,0,0"
                            Padding="10,6"
                            Background="#151A27"
                            BorderBrush="#2E3150"
                            BorderThickness="1"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            MaxWidth="220">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_LastNotification}"
                                       Foreground="#93C5FD"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="TxtNotificationPreview"
                                       Text="{DynamicResource Str_NoNews}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <Grid Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">

                    <!-- LOCAL CLOCK CARD -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_LocalTime}"
                                       Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="TxtLocalTime"
                                       Text="00:00:00"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="72" FontWeight="Light"
                                       FontFamily="Segoe UI Light, Segoe UI"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtLocalDate"
                                       Text="{DynamicResource Str_DateSample}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtLocalZoneName"
                                       Text="&#8212;"
                                       Foreground="{StaticResource AccentBlue}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ALARM LIST CARD -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_ActiveAlarms}"
                                           Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center" Margin="0"/>
                                <Border Grid.Column="1"
                                        Background="{StaticResource AccentGlow}"
                                        CornerRadius="10" Padding="8,2">
                                    <TextBlock x:Name="TxtAlarmCount" Text="0"
                                               Foreground="White" FontSize="11"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <ListBox x:Name="LstAlarms"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="320"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{x:Null}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Opacidad reactiva: 1 = activa, 0.45 = disparada -->
                                        <Border Background="{StaticResource BgInput}"
                                                BorderBrush="#33385A"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,5"
                                                Padding="0"
                                                Opacity="{Binding ItemOpacity}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.35"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Barra de color lateral: refleja la urgencia de la alarma -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding BadgeColor}"
                                                        CornerRadius="12,0,0,12"/>

                                                <Grid Grid.Column="1" Margin="14,12,12,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <!-- Hora + fecha -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       FontSize="19" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding DateText}"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       FontSize="12" VerticalAlignment="Bottom"
                                                                       Margin="8,0,0,3"/>
                                                        </StackPanel>

                                                        <!-- Zona horaria -->
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                                                       Kind="MapMarkerOutline"
                                                                                       Width="11" Height="11"
                                                                                       Foreground="{StaticResource AccentBlue}"
                                                                                       Margin="0,0,4,0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ZoneName}"
                                                                       Foreground="{StaticResource AccentBlue}"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>

                                                        <!-- Cuenta regresiva -->
                                                        <Border Background="#1E2A44"
                                                                CornerRadius="999"
                                                                Padding="9,3"
                                                                Margin="0,7,0,0"
                                                                HorizontalAlignment="Left"
                                                                Visibility="{Binding CountdownVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="TimerSandEmpty"
                                                                                           Width="11" Height="11"
                                                                                           Foreground="{StaticResource TextPrimary}"
                                                                                           Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding CountdownText}"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Nota (oculta si vacía) -->
                                                        <Border Background="#20233A"
                                                                CornerRadius="8"
                                                                Padding="9,7"
                                                                Margin="0,8,0,0"
                                                                Visibility="{Binding NoteVisibility}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <iconPacks:PackIconMaterial Grid.Column="0"
                                                                                           Kind="NoteTextOutline"
                                                                                           Width="12" Height="12"
                                                                                           Foreground="{StaticResource TextMuted}"
                                                                                           Margin="0,2,7,0"
                                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Nota}"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           FontSize="11.5" LineHeight="16"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="48"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Enlace web (oculto si vacío) -->
                                                        <Border Background="#1B2336"
                                                                BorderBrush="#2B3A5B"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="9,7"
                                                                Margin="0,6,0,0"
                                                                Visibility="{Binding LinkVisibility}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <iconPacks:PackIconMaterial Grid.Column="0"
                                                                                           Kind="OpenInNew"
                                                                                           Width="13" Height="13"
                                                                                           Foreground="{StaticResource AccentLink}"
                                                                                           Margin="0,1,6,0"
                                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding LinkUrl}">
                                                            <Hyperlink NavigateUri="{Binding LinkUrl}"
                                                                       Style="{StaticResource AlarmLinkStyle}"
                                                                       Click="AlarmLink_Click">
                                                                    <Run Text="{Binding LinkUrl}"/>
                                                            </Hyperlink>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Etiqueta de estado -->
                                                        <Border Background="{Binding EstadoLabelBackgroundBrush}"
                                                                CornerRadius="999"
                                                                Padding="8,4"
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                Visibility="{Binding EstadoLabelVisibility}">
                                                            <TextBlock Text="{Binding EstadoLabel}"
                                                                       Foreground="{Binding EstadoLabelBrush}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>

                                                        <!-- Acciones -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,10,0,0"
                                                                    Visibility="{Binding ManageActionsVisibility}">
                                                            <Button Style="{StaticResource BtnSecondarySmall}"
                                                                    Tag="{Binding}"
                                                                    Click="BtnMarkAttended_Click"
                                                                    Margin="0,0,10,0"
                                                                    ToolTip="{DynamicResource Str_MarkAttended}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline"
                                                                                               Width="12" Height="12"
                                                                                               Margin="0,0,6,0"
                                                                                               Foreground="#D7E3FF"/>
                                                                    <TextBlock Text="{DynamicResource Str_Attended}"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Style="{StaticResource BtnSecondarySmall}"
                                                                    Tag="{Binding}"
                                                                    Click="BtnOpenSnoozeMenu_Click"
                                                                    ToolTip="{DynamicResource Str_PostponeAlarm}">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Header="{DynamicResource Str_Postpone5}" CommandParameter="5" Click="SnoozeMenuItem_Click"/>
                                                                        <MenuItem Header="{DynamicResource Str_Postpone10}" CommandParameter="10" Click="SnoozeMenuItem_Click"/>
                                                                        <MenuItem Header="{DynamicResource Str_Postpone15}" CommandParameter="15" Click="SnoozeMenuItem_Click"/>
                                                                        <MenuItem Header="{DynamicResource Str_Postpone30}" CommandParameter="30" Click="SnoozeMenuItem_Click"/>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <iconPacks:PackIconMaterial Kind="ClockOutline"
                                                                                               Width="12" Height="12"
                                                                                               Margin="0,0,6,0"
                                                                                               Foreground="#D7E3FF"/>
                                                                    <TextBlock Text="{DynamicResource Str_Snooze}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Botón eliminar -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource BtnDanger}"
                                                            Tag="{Binding}"
                                                            Click="BtnDeleteAlarm_Click"
                                                            VerticalAlignment="Top"
                                                            Margin="8,0,0,0"
                                                            ToolTip="{DynamicResource Str_DeleteAlarm}">
                                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline"
                                                                                   Width="14" Height="14"
                                                                                   Foreground="#FCA5A5"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="TxtNoAlarms"
                                       Text="{DynamicResource Str_NoAlarms}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Margin="0,12" Visibility="Visible"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT COLUMN &#8212; NEW ALARM -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_NewAlarm}"
                                   Style="{StaticResource SectionLabel}"/>

                        <!-- Date -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Str_Date}" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DpkAlarmDate"
                                        Style="{StaticResource DarkDatePicker}"/>
                        </StackPanel>

                        <!-- Time -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock x:Name="TxtAlarmTimeLabel"
                                       Text="{DynamicResource Str_TimeHHMMLabel}" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtAlarmTime"
                                     Style="{StaticResource DarkTextBox}"
                                     MaxLength="8"
                                     TextChanged="TxtAlarmTime_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- Timezone for alarm -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Str_TimeZone}" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <local:TzPickerControl x:Name="AlarmTzPicker" Height="230"/>
                        </StackPanel>

                        <!-- Note -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Str_Note}" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtAlarmNote"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="Auto" MinHeight="36" MaxHeight="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- Optional web link -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Str_WebLink}" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtAlarmLink"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="36" MaxLength="500"/>
                        </StackPanel>

                        <!-- validation message -->
                        <TextBlock x:Name="TxtValidation"
                                   Foreground="#F87171"
                                   FontSize="12" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>

                        <!-- Save button -->
                        <Button x:Name="BtnSaveAlarm"
                                Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch"
                                Click="BtnSaveAlarm_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="BellPlus" Width="15" Height="15"
                                                           Foreground="White" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_SaveAlarm}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- FOOTER: RELOJES MUNDIALES DINÁMICOS -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="24,14,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Título + botón agregar -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Earth" Width="18" Height="18"
                                                   Foreground="{StaticResource AccentBlue}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str_WorldClocks}" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_WorldClocksSub}" Foreground="{StaticResource TextMuted}"
                               FontSize="10" Opacity="0.6" Margin="26,0,0,0"/>

                    <Button x:Name="BtnAddClock"
                            Margin="0,10,0,0"
                            Width="80" Height="28"
                            Background="{StaticResource AccentBlue}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnAddClock_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#6AA3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGlow}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="11" Height="11"
                                                       Foreground="White" Margin="0,0,4,0"
                                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Add}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Lista dinámica de relojes -->
                <ItemsControl x:Name="IcWorldClocks" Grid.Column="1"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ClockCard"
                                    Background="{StaticResource BgInput}" CornerRadius="12"
                                    Margin="0,0,10,6" Padding="14,10"
                                    MinWidth="160" MaxWidth="220"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Nombre + botones -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="MapMarker" Width="12" Height="12"
                                                                       Foreground="{StaticResource AccentBlue}"
                                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="110"/>
                                        </StackPanel>

                                        <!-- Botones editar / eliminar (visibles solo en hover) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                            RelativeSource={RelativeSource AncestorType=Border,
                                                            AncestorLevel=1}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Button Width="20" Height="20" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Margin="2,0,0,0"
                                                    Tag="{Binding}"
                                                    Click="BtnEditClock_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#2A2F47"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <iconPacks:PackIconMaterial Kind="Pencil" Width="10" Height="10"
                                                                           Foreground="{StaticResource AccentBlue}"/>
                                            </Button>

                                            <Button Width="20" Height="20" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Margin="2,0,0,0"
                                                    Tag="{Binding}"
                                                    Click="BtnDeleteClock_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#3D1414"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10"
                                                                           Foreground="#F87171"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hora grande -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding TimeText}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="24" FontWeight="Light"
                                               Margin="0,4,0,0"/>

                                    <!-- Fecha + offset -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DateText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"/>
                                        <TextBlock Text="{Binding OffsetText}"
                                                   Foreground="{StaticResource AccentBlue}"
                                                   FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>

    </Grid>
</Window>