<Window x:Class="WorldTimeAlarms.AlarmNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{DynamicResource Str_AlarmTitle}"
        Icon="/app_logo.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDeep"       Color="#0F1117"/>
        <SolidColorBrush x:Key="BgCard"       Color="#1A1D27"/>
        <SolidColorBrush x:Key="AccentAmber"  Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentAmberDim" Color="#7A4F05"/>
        <SolidColorBrush x:Key="AccentLink"   Color="#60A5FA"/>
        <SolidColorBrush x:Key="AccentLinkHover" Color="#93C5FD"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#9CA3AF"/>
        <SolidColorBrush x:Key="CardBorder"   Color="#2E3150"/>
        <SolidColorBrush x:Key="NoteCardBg"   Color="#22263A"/>

        <Style x:Key="LinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentLink}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentLinkHover}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Accept button style -->
        <Style x:Key="BtnAccept" TargetType="Button">
            <Setter Property="Background"      Value="#F59E0B"/>
            <Setter Property="Foreground"      Value="#0F1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Height"          Value="50"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="32,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDB830"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C47D08"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSnooze" TargetType="Button">
            <Setter Property="Background"      Value="#24304A"/>
            <Setter Property="Foreground"      Value="#D7E3FF"/>
            <Setter Property="BorderBrush"     Value="#355189"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E4370"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow + rounded card -->
    <Border CornerRadius="22"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="8" Opacity="0.7"/>
        </Border.Effect>

        <StackPanel Margin="36,30,36,36">

            <!-- ═══ Bell icon with pulse ring ═══ -->
            <Grid HorizontalAlignment="Center" Width="132" Height="132"
                  Margin="0,0,0,18">

                <!-- Outer pulse ring -->
                <Ellipse x:Name="PulseRing"
                         Width="132" Height="132"
                         Stroke="{StaticResource AccentAmber}"
                         StrokeThickness="2"
                         Opacity="0">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" CenterX="66" CenterY="66"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     From="0.75" To="1.5" Duration="0:0:1.3"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     From="0.75" To="1.5" Duration="0:0:1.3"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.75" To="0" Duration="0:0:1.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <!-- Solid amber circle -->
                <Ellipse Width="98" Height="98"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3D2800" Offset="0"/>
                            <GradientStop Color="#1A1D27" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Amber ring border -->
                <Border Width="98" Height="98"
                        CornerRadius="49"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource AccentAmber}"
                        BorderThickness="2"/>

                <!-- Bell vector icon with swing animation -->
                <iconPacks:PackIconMaterial x:Name="BellIcon"
                                            Kind="Bell"
                                            Width="50" Height="50"
                                            Foreground="#F59E0B"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial.RenderTransform>
                        <RotateTransform x:Name="BellRotate" CenterX="25" CenterY="25"/>
                    </iconPacks:PackIconMaterial.RenderTransform>
                    <iconPacks:PackIconMaterial.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="BellRotate"
                                        Storyboard.TargetProperty="Angle"
                                        Duration="0:0:0.7"
                                        AutoReverse="True">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-20"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="20"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="-14"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.7"  Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </iconPacks:PackIconMaterial.Triggers>
                </iconPacks:PackIconMaterial>
            </Grid>

            <!-- ═══ "ALARMA" label ═══ -->
            <TextBlock Text="&#x25CF;  ALARMA DISPARADA  &#x25CF;"
                       Foreground="{StaticResource AccentAmber}"
                       FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- ═══ Scheduled time (big) ═══ -->
            <TextBlock x:Name="TxtTime"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="56" FontWeight="Light"
                       FontFamily="Segoe UI Light, Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>

            <!-- ═══ Date ═══ -->
            <TextBlock x:Name="TxtDate"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- ═══ Timezone ═══ -->
            <TextBlock x:Name="TxtZone"
                       Foreground="{StaticResource AccentAmber}"
                       FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- ═══ Note card (hidden when empty) ═══ -->
            <Border x:Name="PanelNota"
                    Visibility="Collapsed"
                    Background="{StaticResource NoteCardBg}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    Padding="18,14"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_NoteHeader}"
                               Foreground="{StaticResource AccentAmber}"
                               FontSize="10" FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtNota"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               LineHeight="24"/>
                </StackPanel>
            </Border>

            <!-- ═══ Link card (hidden when empty) ═══ -->
            <Border x:Name="PanelLink"
                    Visibility="Collapsed"
                    Background="{StaticResource NoteCardBg}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    Padding="18,14"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_WebLinkHeader}"
                               Foreground="{StaticResource AccentAmber}"
                               FontSize="10" FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <Border Background="#1B2336"
                            BorderBrush="#2B3A5B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="OpenInNew"
                                                       Width="15" Height="15"
                                                       Foreground="{StaticResource AccentLink}"
                                                       Margin="0,2,8,0"
                                                       VerticalAlignment="Top"/>
                            <TextBlock FontSize="14"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       VerticalAlignment="Center">
                                <Hyperlink x:Name="LnkWeb"
                                           Style="{StaticResource LinkStyle}"
                                           Click="LnkWeb_Click">
                                    <Run x:Name="TxtLink"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ Acciones ═══ -->
            <TextBlock Text="{DynamicResource Str_SnoozeHeader}"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="10" FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Button Style="{StaticResource BtnSnooze}" Margin="0,0,8,0"
                        Click="BtnSnooze_Click" Tag="5" Content="{DynamicResource Str_5Min}"/>
                <Button Style="{StaticResource BtnSnooze}" Margin="0,0,8,0"
                        Click="BtnSnooze_Click" Tag="10" Content="{DynamicResource Str_10Min}"/>
                <Button Style="{StaticResource BtnSnooze}" Margin="0,0,8,0"
                        Click="BtnSnooze_Click" Tag="15" Content="{DynamicResource Str_15Min}"/>
                <Button Style="{StaticResource BtnSnooze}"
                        Click="BtnSnooze_Click" Tag="30" Content="{DynamicResource Str_30Min}"/>
            </UniformGrid>

            <Button x:Name="BtnAceptar"
                    Style="{StaticResource BtnAccept}"
                    Click="BtnAceptar_Click"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline"
                                               Width="18" Height="18"
                                               Foreground="#0F1117"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Str_Attend}" VerticalAlignment="Center"
                               FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnIgnorar"
                    Click="BtnIgnorar_Click"
                    HorizontalAlignment="Stretch"
                    Height="38"
                    Background="Transparent"
                    BorderBrush="#4B5563"
                    BorderThickness="1"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2235"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="BellOff"
                                               Width="16" Height="16"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Str_Ignore}" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#9CA3AF"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</Window>
